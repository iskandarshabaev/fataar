<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <data><variable name="embeddedTitle" type="String" /></data>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/embedded_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@{embeddedTitle}" />
        <include android:id="@+id/external_included" layout="@layout/external_binding" app:externalTitle="@{embeddedTitle}" />
    </LinearLayout>
</layout>
