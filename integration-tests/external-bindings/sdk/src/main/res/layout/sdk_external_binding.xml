<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <data><variable name="sdkTitle" type="String" /></data>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/sdk_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@{sdkTitle}" />
        <include android:id="@+id/embedded_included" layout="@layout/embedded_binding" app:embeddedTitle="@{sdkTitle}" />
    </LinearLayout>
</layout>
